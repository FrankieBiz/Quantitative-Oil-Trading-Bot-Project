# =============================================================================
# Quantitative Oil Trading Bot - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env file to git (it's already in .gitignore)
# =============================================================================

# --- Interactive Brokers (IBKR) ---
# Get these from your IBKR account + TWS/Gateway settings
IBKR_HOST=127.0.0.1
IBKR_CLIENT_ID=1
LIVE_MODE=False
# LIVE_MODE=False → paper trading (port 7497)
# LIVE_MODE=True  → real money (port 7496) *** USE WITH EXTREME CAUTION ***

# --- Twitter / X API ---
# Get from: https://developer.x.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# --- NewsAPI ---
# Get from: https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# --- EIA (U.S. Energy Information Administration) ---
# Get from: https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here

# --- Database ---
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///oil_quant_bot.db
# PostgreSQL (if you set one up):
# DATABASE_URL=postgresql://username:password@localhost:5432/oil_trading_db

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8050

# --- Risk-Free Rate (for Sharpe ratio calculation) ---
# Update periodically to match current Treasury rate
RISK_FREE_RATE=0.05

# --- Logging ---
LOG_LEVEL=INFO
